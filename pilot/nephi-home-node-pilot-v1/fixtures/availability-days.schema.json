{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nephi-home.local/schemas/availability-days.schema.json",
  "title": "Pilot availability days import",
  "type": "object",
  "additionalProperties": false,
  "required": ["propertyId", "days"],
  "properties": {
    "propertyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "301", "302", "401", "402"],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "301": { "type": "string", "enum": ["open", "closed"] },
          "302": { "type": "string", "enum": ["open", "closed"] },
          "401": { "type": "string", "enum": ["open", "closed"] },
          "402": { "type": "string", "enum": ["open", "closed"] }
        }
      }
    }
  }
}
