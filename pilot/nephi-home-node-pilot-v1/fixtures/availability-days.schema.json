{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:junzan:schemas:availability-days",
  "title": "Pilot availability days import",
  "type": "object",
  "additionalProperties": false,
  "required": ["propertyId", "days"],
  "properties": {
    "propertyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date"],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "patternProperties": {
          "^(?!date$)[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$": {
            "type": "string",
            "enum": ["open", "closed"]
          }
        }
      }
    }
  }
}
